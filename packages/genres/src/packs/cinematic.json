{
  "id": "cinematic",
  "displayName": { "he": "קולנועי", "en": "Cinematic" },
  "tempo": { "min": 70, "max": 110, "default": 90 },
  "grid": { "subdivision": 8, "swingAmount": 0 },
  "allowedModes": ["aeolian", "phrygian"],
  "defaultMode": "aeolian",
  "harmonicTendency": "extended",
  "chordProgression": [0, 5, 2, 6],
  "roles": ["bass", "lead", "pad", "drums"],
  "rhythmPatterns": {
    "bass": [{ "name": "long-tones", "stepsPerBar": 8, "hits": [1, 0, 0, 0, 0, 0, 0, 0] }],
    "lead": [{ "name": "melodic-line", "stepsPerBar": 8, "hits": [1, 0, 1, 0, 1, 0, 1, 0] }],
    "pad": [{ "name": "sustained", "stepsPerBar": 8, "hits": [1, 0, 0, 0, 0, 0, 0, 0] }],
    "drums": [{ "name": "timpani-hits", "stepsPerBar": 8, "hits": [1, 0, 0, 0, 1, 0, 0, 0] }]
  },
  "synthMap": {
    "bass": {
      "oscillatorType": "sine",
      "envelope": { "attack": 0.1, "decay": 0.3, "sustain": 0.7, "release": 1 },
      "polyphonic": false,
      "filter": { "type": "lowpass", "frequencyHz": 600, "resonance": 0.5 }
    },
    "lead": {
      "oscillatorType": "triangle",
      "envelope": { "attack": 0.15, "decay": 0.2, "sustain": 0.75, "release": 1.2 },
      "polyphonic": false,
      "filter": { "type": "lowpass", "frequencyHz": 2800, "resonance": 0.6 },
      "unison": { "count": 3, "spreadCents": 10 }
    },
    "pad": {
      "oscillatorType": "sine",
      "envelope": { "attack": 0.8, "decay": 0.4, "sustain": 0.9, "release": 2.5 },
      "polyphonic": true,
      "filter": { "type": "lowpass", "frequencyHz": 3500, "resonance": 0.5 },
      "unison": { "count": 5, "spreadCents": 15 }
    },
    "drums": {
      "oscillatorType": "sine",
      "envelope": { "attack": 0.005, "decay": 0.4, "sustain": 0.1, "release": 0.6 },
      "polyphonic": false
    }
  },
  "mixChain": { "reverbDecaySeconds": 5, "delayTime": "8n", "delayFeedback": 0.2 },
  "arrangement": { "sectionOrder": ["intro", "loop", "build", "outro"] },
  "sidechainEnabled": false,
  "requiresSamples": false
}
